# Copy to .env (git-ignored). Read automatically by the npm scripts.
# LLM key for topic selection and script writing (default provider: DeepSeek, https://platform.deepseek.com)
LLM_API_KEY=
# Optional: any OpenAI-compatible endpoint and model (empty = config.json llm.baseUrl / llm.model)
LLM_BASE_URL=
LLM_MODEL=
# Vision model that drops unrelated pictures (stock photos, wrong screenshots). Uses the same endpoint and key.
# deepseek-flash works with DeepSeek; set another vision model for other providers, or leave empty to skip the check.
LLM_VISION_MODEL=deepseek-flash
# Optional: browser location if not installed in the standard folder
CHROME_PATH=
